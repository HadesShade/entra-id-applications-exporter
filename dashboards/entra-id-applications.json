    {
      "id": 11,
      "type": "table",
      "title": "Credential expiry (soonest first)",
      "description": "One row per secret or certificate. Days left is negative when the credential has already expired.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 12,
        "w": 16,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "((label_replace(label_replace(label_replace(azure_entra_application_secret_expiration_timestamp_seconds{job=~\"$job\",app_name=~\"$application\"}, \"type\", \"secret\", \"\", \"\"), \"credential_name\", \"$1\", \"secret_name\", \"(.*)\"), \"credential_id\", \"$1\", \"secret_id\", \"(.*)\") or label_replace(label_replace(label_replace(azure_entra_application_certificate_expiration_timestamp_seconds{job=~\"$job\",app_name=~\"$application\"}, \"type\", \"certificate\", \"\", \"\"), \"credential_name\", \"$1\", \"certificate_name\", \"(.*)\"), \"credential_id\", \"$1\", \"certificate_id\", \"(.*)\")) - time()) / 86400",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(label_replace(label_replace(label_replace(azure_entra_application_secret_expiration_timestamp_seconds{job=~\"$job\",app_name=~\"$application\"}, \"type\", \"secret\", \"\", \"\"), \"credential_name\", \"$1\", \"secret_name\", \"(.*)\"), \"credential_id\", \"$1\", \"secret_id\", \"(.*)\") or label_replace(label_replace(label_replace(azure_entra_application_certificate_expiration_timestamp_seconds{job=~\"$job\",app_name=~\"$application\"}, \"type\", \"certificate\", \"\", \"\"), \"credential_name\", \"$1\", \"certificate_name\", \"(.*)\"), \"credential_id\", \"$1\", \"certificate_id\", \"(.*)\")) * 1000",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(app_name|type|credential_name|credential_id|Value #[AB])$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "app_name": 0,
              "type": 1,
              "credential_name": 2,
              "credential_id": 3,
              "Value #A": 4,
              "Value #B": 5
            },
            "renameByName": {
              "app_name": "Application",
              "type": "Type",
              "credential_name": "Credential Name",
              "credential_id": "Credential ID",
              "Value #A": "Days left",
              "Value #B": "Expires"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Days left"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "dark-red",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 0
                    },
                    {
                      "color": "orange",
                      "value": 30
                    },
                    {
                      "color": "yellow",
                      "value": 90
                    },
                    {
                      "color": "green",
                      "value": 180
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Expires"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Days left",
            "desc": false
          }
        ],
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 12,
      "type": "bargauge",
      "title": "Soonest expiry per application (days)",
      "description": "For each application, days until its nearest secret or certificate expires.",
      "datasource": {
