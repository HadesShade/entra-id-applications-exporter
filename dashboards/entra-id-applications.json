    },
    {
      "id": 16,
      "type": "table",
      "title": "Application inventory",
      "description": "One row per app registration with owner and credential counts.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "azure_entra_application_info{job=~\"$job\",app_name=~\"$application\"}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (app_id) (azure_entra_application_owners_count{job=~\"$job\",app_name=~\"$application\"})",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (app_id) (azure_entra_application_credentials_count{job=~\"$job\",app_name=~\"$application\",type=\"secret\"})",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (app_id) (azure_entra_application_credentials_count{job=~\"$job\",app_name=~\"$application\",type=\"certificate\"})",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (app_id) (azure_entra_application_created_timestamp_seconds{job=~\"$job\"}) * 1000",
          "refId": "E",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "app_id",
            "mode": "inner"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(app_name|app_id|object_id|sign_in_audience|Value #[B-E])$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "app_name": 0,
              "app_id": 1,
              "object_id": 2,
              "sign_in_audience": 3,
              "Value #B": 4,
              "Value #C": 5,
              "Value #D": 6,
              "Value #E": 7
            },
            "renameByName": {
              "app_name": "Application",
              "app_id": "App (client) ID",
              "object_id": "Object ID",
              "sign_in_audience": "Sign-in audience",
              "Value #B": "Owners",
              "Value #C": "Secrets",
              "Value #D": "Certificates",
              "Value #E": "Created"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Owners"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "orange",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Secrets|Certificates"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Created"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Application",
            "desc": false
          }
        ],
        "footer": {
          "show": false
        }
      }
    },
