    {
      "id": 13,
      "type": "timeseries",
      "title": "Soonest expiry per application (days)",
      "description": "Countdown to the nearest credential expiry for each application. Drops to 0 and below as expiry approaches.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "min by (app_name) ((azure_entra_application_secret_expiration_timestamp_seconds{job=~\"$job\",app_name=~\"$application\"} or azure_entra_application_certificate_expiration_timestamp_seconds{job=~\"$job\",app_name=~\"$application\"}) - time()) / 86400",
          "refId": "A",
          "instant": false,
          "range": true,
          "format": "time_series",
          "legendFormat": "{{app_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
